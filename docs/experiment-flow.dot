digraph experiment_flow {
  graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.35", ranksep="0.45", splines=polyline];
  node [shape=box, style="rounded,filled", fillcolor="#eef0ff", color="#a8a5e6", fontname="DejaVu Sans", fontsize=11, margin="0.16,0.12"];
  edge [color="#656b79", fontname="DejaVu Sans", fontsize=9, arrowsize=0.7];

  A [label="Configure two RXE endpoints"];
  B [label="Build and deploy the C harness"];
  C [shape=diamond, label="Run optional\nshakedown?"];
  D [label="smoke: at most 4,096\nregistrations"];
  E [label="main: at most 600,000\nregistrations"];
  F [label="Owner registers the fixed MR;\nrecord rkey and index"];
  G [label="Maintain sequenced descriptors;\nrequester ACKs before sampled use"];
  H [shape=diamond, label="Earlier target\ngeneration matches?"];
  I [label="Positive control; probe\nsaved descriptor"];
  J [label="Positive control; live probe\non a fresh QP"];
  K [label="Quiesce and deregister the MR"];
  L [shape=diamond, label="Full-rkey\nsample?"];
  M [label="Post-deregistration probe\non another QP"];
  N [label="Write owner and requester ledgers"];
  O [shape=diamond, label="Stop condition?"];
  P [label="Analyze index reuse, full-key\nrecurrence, and probe outcomes"];
  Q [label="Write the compact results table"];
  R [label="Hash artifacts into the run manifest"];
  S [label="Verify manifest and table\nagainst saved data"];
  T [label="Stop and preserve\ndiagnostic records"];

  A -> B -> C;
  C -> D [label="Yes"];
  C -> E [label="No"];
  D -> F;
  E -> F;
  F -> G -> H;
  H -> I [label="Index only; up to 4 samples"];
  H -> J [label="Full rkey; up to 8 samples"];
  H -> K [label="No eligible sample"];
  I -> K;
  J -> K;
  K -> L;
  L -> M [label="Yes"];
  L -> N [label="No"];
  M -> N;
  N -> O;
  O -> F [label="Continue within limits", constraint=false];
  O -> E [label="Smoke complete; controls healthy", constraint=false];
  O -> P [label="Main complete"];
  O -> T [label="Failed control, cleanup, or probe"];
  P -> Q -> R -> S;
}
